{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "ignorePatterns": [
    ".next/**",
    "node_modules/**",
    "public/**",
    "scripts/**",
    ".yarn/**",
    "supabase/.temp/**",
    "next-env.d.ts",
    ".agent/**",
    ".agents/**",
    ".claude/**",
    ".codex/**",
    ".continue/**",
    ".cursor/**",
    ".gemini/**",
    ".omp/**",
    ".opencode/**",
    ".pi/**",
    ".roo/**",
    ".windsurf/**",
    "tools/oxlint/anti-slop/**"
  ],
  "jsPlugins": [
    {
      "name": "anti-slop",
      "specifier": "./tools/oxlint/anti-slop/index.ts"
    }
  ],
  "rules": {
    "oxc/no-accumulating-spread": "error",
    "anti-slop/no-array-filter-map": "error",
    "anti-slop/no-reduce-accumulator-copy": "error",
    "anti-slop/no-chained-type-assertions": "error",
    "anti-slop/no-conditional-empty-object-spread": "error",
    "anti-slop/no-known-value-widening": "error",
    "anti-slop/no-module-mocking": "error",
    "anti-slop/no-object-parameters": "error",
    "anti-slop/no-reflect-apply": "error",
    "anti-slop/no-reflect-get": "error",
    "anti-slop/no-runtime-typeof": "error",
    "anti-slop/no-shape-in-symbol-names": "error",
    "anti-slop/no-unknown-parameters": "error",
    "anti-slop/no-unknown-returns": "error",
    "anti-slop/no-unknown-type-aliases": "error",
    "anti-slop/no-unsafe-dictionary-type": "error",
    "anti-slop/no-widen-then-assert": "error",
    "anti-slop/require-safety-comment-for-type-assertion": "error",
    "anti-slop/require-readable-spacing": "warn"
  },
  "overrides": [
    {
      "files": [
        "src/app/api/ai/route.ts",
        "src/app/api/share/route.ts",
        "src/app/guides/page.tsx",
        "src/app/page.tsx",
        "src/app/progress/page.tsx",
        "src/app/settings/page.tsx",
        "src/app/share/*/page.tsx",
        "src/components/Achievements.tsx",
        "src/components/Analytics.tsx",
        "src/components/ExportButton.tsx",
        "src/components/PWAInstallPrompt.tsx",
        "src/components/SessionHistory.tsx",
        "src/components/TimingGuide.tsx",
        "src/components/UserMenu.tsx",
        "src/contexts/GlobalContext.tsx",
        "src/hooks/useAICoach.ts",
        "src/hooks/useAchievements.ts",
        "src/hooks/useAnalytics.ts",
        "src/hooks/useGamification.ts",
        "src/hooks/useGlobalStats.ts",
        "src/hooks/useTimer.test.ts",
        "src/hooks/useTimer.ts",
        "src/hooks/useTimingGuide.ts",
        "src/lib/analytics.ts",
        "src/lib/errors.ts",
        "src/lib/export/pdf.ts",
        "src/lib/security/ai-sanitization.ts",
        "src/lib/security/csrf.ts",
        "src/lib/security/origin.ts",
        "src/lib/security/ratelimit.ts",
        "src/lib/security/validation.ts",
        "src/lib/seo/linking.ts",
        "src/lib/seo/metadata.ts",
        "src/lib/seo/schema.ts",
        "src/lib/seo/validation.ts",
        "src/lib/server/getData.ts",
        "src/lib/supabase/client.ts",
        "src/lib/type-guards.ts",
        "src/proxy.ts"
      ],
      "rules": {
        "anti-slop/no-array-filter-map": "warn",
        "anti-slop/no-reduce-accumulator-copy": "warn",
        "anti-slop/no-chained-type-assertions": "warn",
        "anti-slop/no-conditional-empty-object-spread": "warn",
        "anti-slop/no-known-value-widening": "warn",
        "anti-slop/no-module-mocking": "warn",
        "anti-slop/no-object-parameters": "warn",
        "anti-slop/no-reflect-apply": "warn",
        "anti-slop/no-reflect-get": "warn",
        "anti-slop/no-runtime-typeof": "warn",
        "anti-slop/no-shape-in-symbol-names": "warn",
        "anti-slop/no-unknown-parameters": "warn",
        "anti-slop/no-unknown-returns": "warn",
        "anti-slop/no-unknown-type-aliases": "warn",
        "anti-slop/no-unsafe-dictionary-type": "warn",
        "anti-slop/no-widen-then-assert": "warn",
        "anti-slop/require-readable-spacing": "warn",
        "anti-slop/require-safety-comment-for-type-assertion": "warn"
      }
    }
  ]
}
